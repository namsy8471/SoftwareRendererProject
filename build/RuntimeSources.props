    <ClInclude Include="src\IO\BackgroundLoader.h" />
    <ClInclude Include="src\IO\FileIO.h" />
  </ItemGroup>
  <!-- 자체 glTF 2.0 로더: 문서 파서(IO)와 장면 변환(Graphics) -->
  <ItemGroup>
    <ClCompile Include="src\IO\Gltf.cpp" />
    <ClCompile Include="src\Graphics\GltfLoader.cpp" />
    <ClInclude Include="src\IO\Gltf.h" />
    <ClInclude Include="src\Graphics\GltfLoader.h" />
  </ItemGroup>
  <!-- 애니메이션: 쿼터니언, 키프레임 샘플링, 재생기, CPU 스키닝(AVX 커널만 /arch:AVX) -->
  <ItemGroup>
    <ClCompile Include="src\Animation\AnimationSampling.cpp" />
    <ClCompile Include="src\Animation\Animator.cpp" />
    <ClCompile Include="src\Animation\Skinning.cpp" />
    <ClCompile Include="src\Animation\SkinningAVX.cpp">
      <AdditionalOptions>/arch:AVX %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClInclude Include="src\Animation\AnimationSampling.h" />
    <ClInclude Include="src\Animation\Animator.h" />
    <ClInclude Include="src\Animation\Skinning.h" />
    <ClInclude Include="src\Math\Quaternion.h" />
  </ItemGroup>
  <!-- 프로젝트 폴더(.srproj)와 씬 파일(.srscene), 열린 프로젝트 세션 -->
  <ItemGroup>
    <ClCompile Include="src\Project\ProjectFiles.cpp" />
    <ClCompile Include="src\Project\ProjectSession.cpp" />
    <ClInclude Include="src\Project\ProjectFiles.h" />
    <ClInclude Include="src\Project\ProjectSession.h" />
  </ItemGroup>
  <!-- 자체 이미지 코덱(PNG/JPEG/BMP/TGA/DDS 디코더, zlib inflate, PNG 인코더). 외부 라이브러리 없이 메모리 버퍼만 다룬다. -->
  <ItemGroup>
    <ClCompile Include="src\Graphics\Codecs\BmpDecoder.cpp" />
    <ClCompile Include="src\Graphics\Codecs\DdsDecoder.cpp" />
    <ClCompile Include="src\Graphics\Codecs\ImageCodecs.cpp" />
    <ClCompile Include="src\Graphics\Codecs\Inflate.cpp" />
