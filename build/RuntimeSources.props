  <!-- 창과 무관한 데모 장면, 프레임 순서(FrameRunner), 가시성 수집, headless 실행, PNG 입출력. CMake는 src/ 아래 .cpp를 자동으로 모은다. -->
  <ItemGroup>
    <ClCompile Include="src\Core\DemoScene.cpp" />
    <ClCompile Include="src\Core\FrameRunner.cpp" />
    <ClCompile Include="src\Core\SceneRenderCollector.cpp" />
    <ClCompile Include="src\Core\HeadlessRunner.cpp" />
