    <ClCompile Include="src\Graphics\Codecs\TgaDecoder.cpp" />
    <ClInclude Include="src\Graphics\Codecs\CodecSupport.h" />
    <ClInclude Include="src\Graphics\Codecs\ImageCodecs.h" />
  </ItemGroup>
