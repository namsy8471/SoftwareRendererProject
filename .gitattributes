# Auto detect text files and perform LF normalization
* text=auto

# 셸 스크립트는 Linux에서 바로 실행되도록 LF, 골든 PNG는 바이너리로 보존한다.
*.sh text eol=lf
*.png binary

# 대용량 Wavefront 모델은 자동 줄바꿈 변환과 거대한 텍스트 diff를 피하고
# 원본 바이트를 그대로 보존한다. 런타임 로더는 파일 내용을 텍스트로 파싱한다.
/assets/**/*.obj binary

# glTF 테스트 표본의 바이너리 버퍼(GltfTests.cpp가 바이트 단위로 읽는다)
*.glb binary
/tests/fixtures/gltf/*.bin binary
# 이미지 디코더 fixture는 바이트 단위로 비교하므로 줄바꿈 변환을 막는다(TGA/BMP/DDS는 NUL이 없으면 텍스트로 오인될 수 있다).
/tests/fixtures/images/** binary
